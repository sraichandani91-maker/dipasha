{
  "name": "dipasha-pharmacy-os",
  "version": "0.0.0",
  "private": true,
  "description": "Dipasha Medical Store operations platform — staff app + owner web console backend",
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "build": "npm run build --workspaces --if-present",
    "typecheck": "npm run typecheck --workspaces --if-present",
    "dev:api": "npm run dev --workspace apps/api",
    "migrate": "npm run migrate --workspace apps/api"
  }
}
