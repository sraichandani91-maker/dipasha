# Copy to .env and fill in. Never commit the real .env (see .gitignore).

# --- Postgres ---
POSTGRES_USER=dipasha
POSTGRES_PASSWORD=change-me
POSTGRES_DB=dipasha

# --- API ---
NODE_ENV=production
PORT=3000
LOG_LEVEL=info
# Set automatically by docker-compose.yml from the Postgres vars above when
# running via Docker. Set explicitly here for local (non-Docker) `npm run dev:api`,
# e.g. postgres://dipasha:change-me@localhost:5432/dipasha
DATABASE_URL=

# --- Auth (Section 3, Section 12) ---
# Generate with: openssl rand -hex 32
JWT_SECRET=
JWT_ACCESS_TTL_SECONDS=900
JWT_REFRESH_TTL_SECONDS=2592000
OTP_TTL_SECONDS=300
OTP_MAX_ATTEMPTS=5

# --- Uploads (Section 9's write-off photo evidence) ---
# Local disk, backed by a named Docker volume so it survives a redeploy —
# see DECISIONS.md for why this isn't object storage yet. Default matches
# the volume mount in docker-compose.yml; only override if you know why.
# UPLOAD_DIR=./uploads
# MAX_UPLOAD_BYTES=8388608

# --- Caddy / TLS (only needed for `docker compose --profile proxy up`) ---
# Subdomain on the domain you already own, per Section 12B.1.
DOMAIN=app.dipashamedicalstore.in

# --- AI invoice scanning (Section 6.3, M9) ---
# Vision-capable LLM for invoice extraction (Claude). Get a key at
# console.anthropic.com. Without this set, invoice scanning falls back
# straight to the blank manual-entry form (Section 6.3's own fallback
# rule) — never a dead end, just no AI assist.
ANTHROPIC_API_KEY=
