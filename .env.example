# Copy to .env and fill in. Never commit the real .env (see .gitignore).

# --- Postgres ---
POSTGRES_USER=dipasha
POSTGRES_PASSWORD=change-me
POSTGRES_DB=dipasha

# --- API ---
NODE_ENV=production
PORT=3000
LOG_LEVEL=info
# Set automatically by docker-compose.yml from the Postgres vars above when
# running via Docker. Set explicitly here for local (non-Docker) `npm run dev:api`,
# e.g. postgres://dipasha:change-me@localhost:5432/dipasha
DATABASE_URL=

# --- Auth (Section 3, Section 12) ---
# Generate with: openssl rand -hex 32
JWT_SECRET=
JWT_ACCESS_TTL_SECONDS=900
JWT_REFRESH_TTL_SECONDS=2592000
OTP_TTL_SECONDS=300
OTP_MAX_ATTEMPTS=5

# --- Uploads (Section 9's write-off photo evidence) ---
# Local disk, backed by a named Docker volume so it survives a redeploy —
# see DECISIONS.md for why this isn't object storage yet. Default matches
# the volume mount in docker-compose.yml; only override if you know why.
# UPLOAD_DIR=./uploads
# MAX_UPLOAD_BYTES=8388608

# --- Caddy / TLS (only needed for `docker compose --profile proxy up`) ---
# Subdomain on the domain you already own, per Section 12B.1.
DOMAIN=app.dipashamedicalstore.in

# --- AI invoice scanning (Section 6.3, M9) ---
# Vision-capable LLM for invoice extraction (Claude). Get a key at
# console.anthropic.com. Without this set, invoice scanning falls back
# straight to the blank manual-entry form (Section 6.3's own fallback
# rule) — never a dead end, just no AI assist.
ANTHROPIC_API_KEY=

# --- Error tracking (Section 12B.4, M16) ---
# A Sentry project's DSN (or a self-hosted/GlitchTip equivalent — anything
# that speaks the Sentry SDK protocol). Get one at sentry.io once you have
# an account (Section 14 — yours to create). Without this set, error
# tracking is a complete no-op: nothing breaks, you just won't get alerted
# to a crash until someone tells you. See scripts/README.md for the
# uptime/backup-freshness WhatsApp alerts, which work independently of this.
SENTRY_DSN=
# A separate Sentry project (or the same one) for the web console — the
# browser SDK, not the Node one, so it's a different DSN. Baked into the
# static bundle at `docker compose build` time (see apps/web/Dockerfile),
# so changing this needs a rebuild, not just a restart.
VITE_SENTRY_DSN=
# Shown on every Sentry event so you can tell which deploy a bug came
# from. deploy.sh sets this to the git commit SHA automatically — only
# override by hand if you know why.
# RELEASE_VERSION=

# --- Backups (Section 12B.3, M16) ---
# Where scripts/backup.sh writes local dump/archive files before (and if)
# copying them off-server. Defaults to ./backups if unset.
# BACKUP_DIR=./backups
# BACKUP_RETENTION_DAYS=30
# An rclone remote (run `rclone config` once to set one up against S3,
# Backblaze B2, Google Drive, etc. — whatever real object storage you
# end up buying, Section 14) in the form "remotename:bucket/path". Unset
# means backups stay local-only — scripts/backup.sh warns loudly about
# this every run, since Section 12B.3 treats off-server storage as
# non-negotiable.
# BACKUP_RCLONE_REMOTE=

# --- Uptime + backup-freshness alerts (Section 12B.4/12B.3, M16) ---
# The number these two cron scripts (scripts/uptime-check.sh,
# scripts/backup-freshness-check.sh) alert — almost certainly your own.
# Unset means alerts are only printed to stdout (redirect that to a log
# file in the crontab line — see RUNBOOK.md — or you won't see them).
# WHATSAPP_ALERT_PHONE=
# A real WhatsApp Business Cloud API token + phone_number_id (Section
# 12A.1, Section 14 — the account is yours to set up). Without both set,
# the alert scripts fall back to logging instead of sending, same as
# every other not-yet-credentialed integration in this build.
# WHATSAPP_CLOUD_API_TOKEN=
# WHATSAPP_CLOUD_API_PHONE_NUMBER_ID=
# Overrides the health-check URL (default: https://$DOMAIN/api/health).
# Mainly useful for testing against a local server directly.
# UPTIME_CHECK_URL=
