# Only needed when the web build is hosted separately from the API
# (e.g. Netlify/Vercel static hosting, no Caddy proxy in front). Point
# it at the real API's origin — no trailing slash, no "/api" suffix
# (apps/api's routes are mounted at root, e.g. POST /auth/otp/request).
# Leave unset for local dev (Vite's proxy) and the Docker+Caddy setup,
# both of which already resolve the relative "/api" path correctly.
VITE_API_BASE_URL=https://api.yourdomain.com
